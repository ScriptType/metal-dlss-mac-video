+import CryptoKit
+import Foundation
+import MLX
+import VideoToolbox
+import XCTest
+@testable import DLSSMedia
+@testable import DLSSMLX
+
+/// Opt in with MLXDLSS_FLOW_POOL_INPUTS and MLXDLSS_FLOW_POOL_BENCH_OUTPUT.
+/// No model, decoder, processing-size resize or public playback settings change.
+final class NativeFlowOutputPoolBenchmarkTests: XCTestCase, @unchecked Sendable {
+  private struct Input: Decodable {
+    struct Pin: Decodable { let path: String; let bytes: Int; let sha256: String }
+    struct Time: Codable { let value: Int64; let timescale: Int32 }
+    struct Frame: Decodable {
+      let sourceFrameIndex: Int
+      let pts: Time
+      let duration: Time
+      let path: String
+      let sha256: String
+      let bytes: Int
+    }
+    let width: Int
+    let height: Int
+    let frames: [Frame]
+    let captureManifest: Pin
+    let source: Pin
+  }
+
+  private func require(_ value: Bool, _ message: String) throws {
+    if !value { throw NSError(domain: "NativeFlowPoolBenchmark", code: 1,
+      userInfo: [NSLocalizedDescriptionKey: message]) }
+  }
+  private func digest(_ data: Data) -> String {
+    SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+  }
+  private func fileDigest(_ url: URL) throws -> String {
+    let handle = try FileHandle(forReadingFrom: url)
+    defer { try? handle.close() }
+    var hash = SHA256()
+    while let data = try handle.read(upToCount: 1024 * 1024), !data.isEmpty { hash.update(data: data) }
+    return hash.finalize().map { String(format: "%02x", $0) }.joined()
+  }
+  private func arraySummary(_ data: Data) -> [String: Any] {
+    var minimum = Float.infinity, maximum = -Float.infinity, sum = Double(0), nonfinite = 0
+    data.withUnsafeBytes { bytes in
+      for value in bytes.bindMemory(to: Float.self) {
+        if value.isFinite { minimum = min(minimum, value); maximum = max(maximum, value); sum += Double(value) }
+        else { nonfinite += 1 }
+      }
+    }
+    return ["sha256": digest(data), "bytes": data.count, "nonfiniteComponents": nonfinite,
+      "minimum": minimum.isFinite ? (Double(minimum) as Any) : NSNull(),
+      "maximum": maximum.isFinite ? (Double(maximum) as Any) : NSNull(),
+      "mean": sum / Double(max(1, data.count / 4))]
+  }
+
+  func testMatchedFullResolutionVideoToolboxPoolBenchmark() async throws {
+    let environment = ProcessInfo.processInfo.environment
+    guard let inputPath = environment["MLXDLSS_FLOW_POOL_INPUTS"],
+      let outputPath = environment["MLXDLSS_FLOW_POOL_BENCH_OUTPUT"] else {
+      throw XCTSkip("Opt-in real VideoToolbox flow allocation benchmark")
+    }
+    var root = URL(fileURLWithPath: #filePath)
+    for _ in 0..<5 { root.deleteLastPathComponent() }
+    let inputURL = URL(fileURLWithPath: inputPath)
+    let output = URL(fileURLWithPath: outputPath)
+    try require(!FileManager.default.fileExists(atPath: output.path) &&
+      (try? output.resourceValues(forKeys: [.isSymbolicLinkKey]).isSymbolicLink) != true,
+      "Benchmark output must be a new path")
+    try FileManager.default.createDirectory(at: output, withIntermediateDirectories: false)
+    var report: [String: Any] = ["schemaVersion": 1, "passed": false,
+      "scope": "Actual NativeOpticalFlow.prepare, fresh versus pooled VT outputs; completed stage wall, not isolated GPU time or Live throughput",
+      "roundPairs": 4, "traversalsPerCase": 3, "warmupCallsPerTraversal": 3,
+      "requestedBackend": MediaMotion.videoToolbox.rawValue, "modelLoaded": false,
+      "limitations": ["Only output allocation changes; source conversion, VT revision and working extent remain unchanged",
+        "Full array SHA256 and scalar bits compared for every matched call; direct byte comparisons at cut and first warmed frame of every traversal",
+        "Array readback, hashing and comparisons are outside prepare timing; they still influence total process duration and operating conditions",
+        "No inferred end-to-end, Live, temporal-quality or M5 acceptance"]]
+    var records: [[String: Any]] = []
+    var frozen: [String: String] = [:]
+    func publish() throws {
+      var snapshot = report
+      snapshot["samples"] = records
+      try JSONSerialization.data(withJSONObject: snapshot, options: [.prettyPrinted, .sortedKeys])
+        .write(to: output.appendingPathComponent("report.json"), options: .atomic)
+    }
+    let priorCachePolicy = MLXRuntimeDiagnostics.cacheLimitBytes
+    report["priorMLXCachePolicyBytes"] = priorCachePolicy
+    defer {
+      do {
+        try MLXRuntimeDiagnostics.setCacheLimitBytes(priorCachePolicy)
+        report["restoredMLXCachePolicyBytes"] = MLXRuntimeDiagnostics.cacheLimitBytes
+      } catch {
+        report["passed"] = false
+        report["cacheRestorationError"] = error.localizedDescription
+      }
+      try? publish()
+    }
+    do {
+      if #available(macOS 15.4, *) {
+        try require(VTOpticalFlowConfiguration.isSupported, "VideoToolbox optical flow unavailable; opt-in benchmark must perform actual work")
+      } else {
