+      report["width"] = input.width; report["height"] = input.height
+      let paths = [".build/debug/hdr-benchmark", ".build/debug/libFrameEngineShared.dylib", ".build/debug/mlx.metallib",
+        "vendor/MLX-DLSS/Sources/DLSSMedia/NativeOpticalFlow.swift", "vendor/MLX-DLSS/Sources/DLSSMedia/NativeImageIO.swift",
+        "vendor/MLX-DLSS/Sources/DLSSMLX/MLXVideoFrame.swift", "vendor/MLX-DLSS/Sources/DLSSMLX/MLXVideoMotion.swift",
+        "vendor/MLX-DLSS/Tests/DLSSMediaTests/NativeFlowOutputPoolTests.swift",
+        "vendor/MLX-DLSS/Tests/DLSSMediaTests/NativeFlowOutputPoolBenchmarkTests.swift"]
+      for path in paths { frozen[root.appendingPathComponent(path).path] = try fileDigest(root.appendingPathComponent(path)) }
+      if let executable = Bundle(for: Self.self).executableURL { frozen[executable.path] = try fileDigest(executable) }
+      frozen[inputURL.path] = digest(inputData)
+      for pin in [input.captureManifest, input.source] {
+        let url = pin.path.hasPrefix("/") ? URL(fileURLWithPath: pin.path) : root.appendingPathComponent(pin.path)
+        let size = try url.resourceValues(forKeys: [.fileSizeKey]).fileSize
+        try require(size == pin.bytes && fileDigest(url) == pin.sha256, "Source/capture pin mismatch")
+        frozen[url.path] = pin.sha256
+      }
+      try MLXRuntimeDiagnostics.setCacheLimitBytes(256 * 1024 * 1024)
+      report["benchmarkMLXCachePolicyBytes"] = MLXRuntimeDiagnostics.cacheLimitBytes
+      var frames: [MLXVideoFrame] = []
+      for frame in input.frames {
+        let url = frame.path.hasPrefix("/") ? URL(fileURLWithPath: frame.path) : root.appendingPathComponent(frame.path)
+        let data = try Data(contentsOf: url)
+        try require(data.count == frame.bytes && data.count == 1920 * 1080 * 12 && digest(data) == frame.sha256,
+          "Proxy input pin mismatch at \(frame.sourceFrameIndex)")
+        try require(frame.duration.value == 1001 && frame.duration.timescale == 24000 && frame.pts.timescale == 24000,
+          "Unexpected exact source timing")
+        frozen[url.path] = frame.sha256
+        frames.append(try MLXVideoFrame(rgb: data, width: input.width, height: input.height))
+      }
+      report["frozenSHA256Before"] = frozen
+      let fresh = try NativeOpticalFlow(width: input.width, height: input.height, mode: .videoToolbox, outputAllocation: .fresh)
+      let pooled = try NativeOpticalFlow(width: input.width, height: input.height, mode: .videoToolbox, outputAllocation: .pooled)
+      try require(fresh.backend == MediaMotion.videoToolbox.rawValue && pooled.backend == MediaMotion.videoToolbox.rawValue,
+        "Actual backend must be VideoToolbox")
+      report["actualBackends"] = ["fresh": fresh.backend, "pooled": pooled.backend]
+      var lastIndex: [String: Int] = [:]
+      var exact = true, directChecks = 0, comparedCalls = 0
+      for pair in 0..<4 {
+        let order: [NativeFlowOutputAllocation] = pair.isMultiple(of: 2) ? [.fresh, .pooled] : [.pooled, .fresh]
+        var reference: [[String: Any]] = []
+        var byteControls: [Int: NativeFlowSnapshot] = [:]
+        for (caseOrder, strategy) in order.enumerated() {
+          let estimator = strategy == .fresh ? fresh : pooled
+          for traversal in 0..<3 {
+            for index in frames.indices {
+              let source = input.frames[index], ordinal = traversal * frames.count + index
+              let wrapped = lastIndex[strategy.rawValue].map { $0 + 1 != source.sourceFrameIndex } ?? false
+              let start = DispatchTime.now().uptimeNanoseconds
+              let motion = try await estimator.prepare(frames[index], index: source.sourceFrameIndex, sceneCutThreshold: 0.3)
+              let elapsed = Double(DispatchTime.now().uptimeNanoseconds - start) / 1e9
+              let memory = MLXRuntimeDiagnostics.memorySnapshot()
+              lastIndex[strategy.rawValue] = source.sourceFrameIndex
+              var sample: [String: Any] = ["pair": pair, "caseOrder": caseOrder, "strategy": strategy.rawValue,
+                "traversal": traversal, "sourceFrameIndex": source.sourceFrameIndex,
+                "pts": ["value": source.pts.value, "timescale": Int64(source.pts.timescale)],
+                "duration": ["value": source.duration.value, "timescale": Int64(source.duration.timescale)],
+                "inputSHA256": source.sha256, "wrapDiscontinuity": wrapped, "excludedWarmup": index < 3,
+                "prepareCompletedWallSeconds": elapsed, "hasMotion": motion != nil,
+                "mlxBytes": ["active": memory.activeBytes, "cache": memory.cacheBytes, "peakActive": memory.peakActiveBytes]]
