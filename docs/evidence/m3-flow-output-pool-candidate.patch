+      }
+      report["frozenSHA256After"] = after
+      report["frozenFilesUnchanged"] = true
+      report["comparedCalls"] = comparedCalls; report["directByteChecks"] = directChecks
+      report["allComparedOutputsExact"] = exact
+      report["passed"] = exact && records.count == 288 && comparedCalls == 144 && directChecks == 24
+      try publish()
+      XCTAssertTrue(report["passed"] as? Bool == true, "Matched benchmark output check failed; retained report has every sample")
+    } catch {
+      report["failure"] = error.localizedDescription
+      try? publish()
+      throw error
+    }
+  }
+}
