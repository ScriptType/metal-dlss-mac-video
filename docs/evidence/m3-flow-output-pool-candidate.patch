+                  }
+                }
+              }
+              sample["signature"] = signature
+              if caseOrder == 0 { reference.append(signature) }
+              else {
+                let equal = NSDictionary(dictionary: reference[ordinal]).isEqual(to: signature)
+                sample["matchedExact"] = equal; comparedCalls += 1; exact = exact && equal
+              }
