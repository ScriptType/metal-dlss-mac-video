diff --git a/Tests/DLSSMediaTests/NativeFlowOutputPoolTests.swift b/Tests/DLSSMediaTests/NativeFlowOutputPoolTests.swift
new file mode 100644
index 0000000..7983d4e
--- /dev/null
+++ b/Tests/DLSSMediaTests/NativeFlowOutputPoolTests.swift
@@ -0,0 +1,140 @@
+import CoreVideo
+import Foundation
+import IOSurface
+import MLX
+import VideoToolbox
+import XCTest
+@testable import DLSSMedia
+@testable import DLSSMLX
+
+struct NativeFlowSnapshot: Equatable {
+  let vectors: Data
+  let confidence: Data
+  let reset: Bool
+  let reliableFraction: Float
+  let warpedLumaError: Float
+
+  init(_ motion: MLXVideoMotion) {
+    vectors = motion.vectors.asData(access: .copy).data
+    confidence = motion.confidence.asData(access: .copy).data
+    reset = motion.reset
+    reliableFraction = motion.reliableFraction
+    warpedLumaError = motion.warpedLumaError
+  }
+
+  var finite: Bool {
+    [vectors, confidence].allSatisfy { data in
+      data.withUnsafeBytes { $0.bindMemory(to: Float.self).allSatisfy(\.isFinite) }
+    } && reliableFraction.isFinite && warpedLumaError.isFinite
+  }
+
+  static func == (a: Self, b: Self) -> Bool {
+    a.vectors == b.vectors && a.confidence == b.confidence && a.reset == b.reset &&
+      a.reliableFraction.bitPattern == b.reliableFraction.bitPattern &&
+      a.warpedLumaError.bitPattern == b.warpedLumaError.bitPattern
+  }
+}
+
+final class NativeFlowOutputPoolTests: XCTestCase, @unchecked Sendable {
+  private func surfaceID(_ buffer: MLXPixelBuffer) throws -> IOSurfaceID {
+    IOSurfaceGetID(try XCTUnwrap(CVPixelBufferGetIOSurface(buffer.buffer)?.takeUnretainedValue()))
+  }
+
+  func testRetainedBuffersEnforceCapacityAndReleasedBufferCanBeReused() throws {
+    let pool = try NativeFlowOutputPool(width: 17, height: 9)
+    var held: [MLXPixelBuffer] = []
+    for _ in 0..<NativeFlowOutputPool.capacity { held.append(try pool.makeBuffer()) }
+    let identities = try held.map(surfaceID)
+    XCTAssertEqual(Set(identities).count, 4)
+    for buffer in held {
+      XCTAssertEqual(buffer.width, 17)
+      XCTAssertEqual(buffer.height, 9)
+      XCTAssertEqual(CVPixelBufferGetPixelFormatType(buffer.buffer), kCVPixelFormatType_TwoComponent16Half)
+      XCTAssertNotNil(CVPixelBufferGetIOSurface(buffer.buffer))
+    }
+    XCTAssertThrowsError(try pool.makeBuffer()) { error in
+      XCTAssertTrue(error.localizedDescription.contains(String(kCVReturnWouldExceedAllocationThreshold)))
+    }
+    held.removeLast()
+    let replacement = try pool.makeBuffer()
+    XCTAssertEqual(try surfaceID(replacement), identities.last)
+    XCTAssertThrowsError(try pool.makeBuffer())
+    XCTAssertEqual(held.count, 3)
+  }
+
+  func testSecondDestinationFailureReleasesFirstTemporary() throws {
+    let pool = try NativeFlowOutputPool(width: 17, height: 9)
+    let held = try (0..<3).map { _ in try pool.makeBuffer() }
+    XCTAssertThrowsError(try pool.makePair())
+    let remaining = try pool.makeBuffer()
+    XCTAssertFalse(try held.map(surfaceID).contains(surfaceID(remaining)))
+    XCTAssertThrowsError(try pool.makeBuffer())
+    withExtendedLifetime(held) {}
+  }
+
+  func testLazyManagedOwnerPreventsRecyclingAndSurvivesPoolRelease() throws {
+    var pool: NativeFlowOutputPool? = try NativeFlowOutputPool(width: 17, height: 9)
+    var source: MLXPixelBuffer? = try pool!.makeBuffer()
+    let originalID = try surfaceID(source!)
+    let lockStatus = CVPixelBufferLockBaseAddress(source!.buffer, [])
+    XCTAssertEqual(lockStatus, kCVReturnSuccess)
+    guard lockStatus == kCVReturnSuccess else { return }
+    do {
+      defer { CVPixelBufferUnlockBaseAddress(source!.buffer, []) }
+      let scalarCount = CVPixelBufferGetBytesPerRow(source!.buffer) * source!.height / 2
+      let address = try XCTUnwrap(CVPixelBufferGetBaseAddress(source!.buffer))
+      address.assumingMemoryBound(to: Float16.self).initialize(repeating: Float16(0.25), count: scalarCount)
+    }
+    var storage: MLXArray? = try MLXVideoFrame.storage(source!.buffer, dtype: .float16)
+    let lazy = storage! + 1
+    source = nil; storage = nil
+    let held = try (0..<3).map { _ in try pool!.makeBuffer() }
+    XCTAssertFalse(try held.map(surfaceID).contains(originalID))
+    XCTAssertThrowsError(try pool!.makeBuffer())
+    pool = nil
+    eval(lazy)
+    XCTAssertTrue(lazy.asArray(Float.self).allSatisfy { $0 == 1.25 })
+    XCTAssertEqual(held.count, 3)
+    XCTAssertTrue(try held.map(surfaceID).allSatisfy { $0 != originalID })
+  }
+
+  func testSequentialVideoToolboxReuseMatchesFreshAndPreservesRetainedMotion() async throws {
+    guard #available(macOS 15.4, *), VTOpticalFlowConfiguration.isSupported else {
+      throw XCTSkip("VideoToolbox optical flow is unavailable")
+    }
+    let fresh: NativeOpticalFlow, pooled: NativeOpticalFlow
+    do {
+      fresh = try NativeOpticalFlow(width: 128, height: 96, mode: .videoToolbox, outputAllocation: .fresh)
+      pooled = try NativeOpticalFlow(width: 128, height: 96, mode: .videoToolbox, outputAllocation: .pooled)
+    } catch let error as VTFrameProcessorError where error.code == .initializationFailed {
+      throw XCTSkip("VideoToolbox cannot start its hardware processing pipeline")
+    }
+    var inputs = try (0..<8).map { try NativeOpticalFlowTests.texture(width: 128, height: 96, dx: $0 * 2, dy: -$0) }
+    inputs[6] = try [Float](repeating: 0, count: 128 * 96 * 3).withUnsafeBytes {
+      try MLXVideoFrame(rgb: Data($0), width: 128, height: 96)
+    }
+    inputs[7] = try [Float](repeating: 1, count: 128 * 96 * 3).withUnsafeBytes {
+      try MLXVideoFrame(rgb: Data($0), width: 128, height: 96)
+    }
+    let inputBytes = inputs.map { $0.copyRGBData() }
+    var retained: [(motion: MLXVideoMotion, snapshot: NativeFlowSnapshot)] = []
+    // Three traversals exceed the two-pair pool and exercise wrap discontinuities.
+    for _ in 0..<3 {
+      for index in inputs.indices {
+        let a = try await fresh.prepare(inputs[index], index: index, sceneCutThreshold: 0.3)
+        let b = try await pooled.prepare(inputs[index], index: index, sceneCutThreshold: 0.3)
+        XCTAssertEqual(a == nil, b == nil)
+        if let a, let b {
+          let expected = NativeFlowSnapshot(a), actual = NativeFlowSnapshot(b)
+          XCTAssertTrue(expected.finite && actual.finite)
+          XCTAssertTrue(actual == expected, "Fresh and pooled motion differ at source index \(index)")
+          retained.append((b, actual))
+        }
+        for old in retained { XCTAssertTrue(NativeFlowSnapshot(old.motion) == old.snapshot) }
+      }
+    }
+    XCTAssertEqual(retained.count, 23)
+    XCTAssertTrue(retained.contains { $0.snapshot.reset }, "Actual cut must exercise a reset")
+    for (frame, bytes) in zip(inputs, inputBytes) { XCTAssertEqual(frame.copyRGBData(), bytes) }
+  }
+}
