  "implementation": {
    "origin": "Use earliest valid known nonattached A/V header start only when AVFormatContext.start_time is AV_NOPTS_VALUE; preserve supplied aggregate origin.",
    "duration": "Retain existing estimate unless a checked known A/V end minus chosen origin exceeds ceil(existingDuration * AV_TIME_BASE). Add start+duration in original ticks before one endpoint rescale.",
    "precision": "Enclosing-microsecond comparison preserves existing precise Double durations; no artificial rounded sub-microsecond tail. HDR10+ real 41.708333ms extension remains.",
    "exclusions": "Subtitle/data/attached-picture streams, invalid timebase, unknown start, nonpositive/unknown duration and arithmetic/rescale overflow cannot invent a span. This intentionally differs from full FFmpeg aggregate inference.",
    "packetTiming": "Product patch changes aggregate origin/range only. Existing player rebase applies its offset before decoding; source file packet timing/content is not rewritten.",
    "preparedIdentity": "Independent provider applies active source_timestamp_offset once. Identifier contains mpv revision, demuxer, timestamp offset, decoder/timing policy and color settings; former zero-offset keys are distinct."
  },
